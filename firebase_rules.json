{
  "rules": {
    "users": {
      ".read": "auth != null && root.child('users').child(auth.uid).child('role').exists()",
      "$uid": {
        ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'",
        "email": {
          ".write": "auth != null && (($uid === auth.uid && root.child('users').child($uid).child('role').exists()) || root.child('users').child(auth.uid).child('role').val() === 'admin')"
        },
        "displayName": {
          ".write": "auth != null && (($uid === auth.uid && root.child('users').child($uid).child('role').exists()) || root.child('users').child(auth.uid).child('role').val() === 'admin')"
        },
        "createdAt": {
          ".write": "auth != null && (($uid === auth.uid && root.child('users').child($uid).child('role').exists()) || root.child('users').child(auth.uid).child('role').val() === 'admin')"
        },
        "lastLogin": {
          ".write": "auth != null && $uid === auth.uid && root.child('users').child($uid).child('role').exists()"
        },
        "role": {
          ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'"
        }
      }
    },
    "tawan_app": {
      ".read": "auth != null && root.child('users').child(auth.uid).child('role').exists()",
      ".write": "auth != null && root.child('users').child(auth.uid).child('role').exists()"
    },
    "tawan_bill_photos": {
      ".read": "auth != null && root.child('users').child(auth.uid).child('role').exists()",
      ".write": "auth != null && root.child('users').child(auth.uid).child('role').exists()"
    },
    "tawan_events": {
      "$eventId": {
        ".write": "auth != null && root.child('users').child(auth.uid).child('role').exists() && !data.exists() && newData.child('actorUid').val() === auth.uid",
        ".validate": "newData.hasChildren(['type','actorUid','at']) && (newData.hasChild('billId') || newData.hasChild('itemId'))"
      }
    }
  }
}
